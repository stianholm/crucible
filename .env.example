# Copy to .env and fill in every value. .env is in .gitignore; never commit it.
# Generate secrets with: openssl rand -hex 32

# Hugging Face, for downloading gpt-oss-120b and Qwen3-4B
HF_TOKEN=

# Postgres, Redis, MinIO and ClickHouse (shared by Langfuse and the harness)
POSTGRES_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
CLICKHOUSE_PASSWORD=

# Langfuse server. ENCRYPTION_KEY must be 64 hex characters (openssl rand -hex 32).
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# Langfuse's first organisation, project and user, created on first start
LANGFUSE_INIT_ORG_ID=crucible
LANGFUSE_INIT_ORG_NAME=crucible
LANGFUSE_INIT_PROJECT_ID=crucible
LANGFUSE_INIT_PROJECT_NAME=crucible
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-change-me
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=

# LiteLLM sends traces to Langfuse with the project keys above
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_HOST=http://langfuse-web:3000

# Grafana admin login
GRAFANA_ADMIN_PASSWORD=

# Optional: push alerts to your phone through an ntfy topic URL. The topic
# name is the only protection, so make it long and random. Leave empty to keep
# alerts on the machine (docs/operations.md).
NTFY_URL=

# Optional: where ops/backup.sh writes (default ~/crucible-backups)
# CRUCIBLE_BACKUP_DIR=
